# Set these in GoDaddy Node.js Hosting UI → Environment Variables
# Do NOT upload a .env file — configure these through the GoDaddy interface.

# Port — GoDaddy sets this automatically
PORT=3000

# Admin key — password-protects GET /api/submissions
ADMIN_KEY=change-me-to-something-secret

# MySQL — GoDaddy Hosted Database
# These five variables are injected automatically by GoDaddy when you
# attach a Hosted Database to your Node.js app. You do not enter them manually.
DB_HOST=injected-by-godaddy
DB_PORT=3306
DB_USER=injected-by-godaddy
DB_PASSWORD=injected-by-godaddy
DB_NAME=injected-by-godaddy

# Email notifications (optional — leave blank to disable)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-email-password
NOTIFY_EMAIL=you@yourdomain.com
